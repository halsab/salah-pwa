# These operations can discard local work, remove saved work, or rewrite history.
prefix_rule(
    pattern = ["git", ["reset", "clean", "restore", "rebase", "filter-branch", "filter-repo", "reflog", "update-ref", "replace", "gc", "prune"]],
    decision = "prompt",
    justification = "This Git operation may discard work or rewrite history; get the user's explicit approval first",
    match = ["git reset --hard", "git clean -fd", "git restore .", "git rebase main", "git reflog expire --all"],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Checkout can replace working-tree paths or change branches; get the user's explicit approval first",
    match = ["git checkout -- .", "git checkout -f main", "git checkout main"],
)

prefix_rule(
    pattern = ["git", "switch", ["--discard-changes", "-f", "--force"]],
    decision = "prompt",
    justification = "Discarding working-tree changes requires the user's explicit approval",
    match = ["git switch --discard-changes main", "git switch -f main"],
)

# Pushes and commits are allowed only after a direct user request.
prefix_rule(
    pattern = ["git", ["push", "commit"]],
    decision = "prompt",
    justification = "The project requires a direct user request before committing or pushing",
    match = ["git push", "git push --force-with-lease", "git commit -m update"],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "--delete", "-f", "--force"]],
    decision = "prompt",
    justification = "Deleting a branch may remove unmerged work; get the user's explicit approval first",
    match = ["git branch -D topic", "git branch -d topic"],
)

prefix_rule(
    pattern = ["git", "tag", "-d"],
    decision = "prompt",
    justification = "Deleting a tag changes repository history references; get the user's explicit approval first",
    match = ["git tag -d v1.0"],
)

prefix_rule(
    pattern = ["git", "stash", ["drop", "clear"]],
    decision = "prompt",
    justification = "Removing stashed work requires the user's explicit approval",
    match = ["git stash drop", "git stash clear"],
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Amending a commit rewrites history; get the user's explicit approval first",
    match = ["git commit --amend"],
)
