{
  "name": "salah-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:offline": "playwright test tests/offline.spec.ts",
    "smoke:sw-update": "playwright test tests/sw-update.spec.ts --workers=1",
    "data:update": "tsx scripts/update-prayer-data.ts",
    "data:update:prayer-manifest": "tsx scripts/update-prayer-manifest.ts",
    "data:update:cities": "tsx scripts/update-city-data.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "adhan": "4.4.6",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
